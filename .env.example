# Max Bot API
BOT_TOKEN=your_bot_token_from_master_bot
MAX_API_BASE_URL=https://platform-api.max.ru

# Webhook
WEBHOOK_URL=https://your-domain.ru/webhook
# 5-256 символов, [A-Za-z0-9-]; передаётся в POST /subscriptions, валидируется в X-Max-Bot-Api-Secret
WEBHOOK_SECRET=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dom_max
DB_USER=dom_max
DB_PASSWORD=change_me

# Redis
REDIS_URL=redis://localhost:6379/0

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Rate limits
NOTIFY_RPS=25                  # ≤ 30 RPS (лимит Max API)
RATE_LIMITER_FAIL_OPEN=false   # При недоступности Redis отказывать (закрытый режим)
